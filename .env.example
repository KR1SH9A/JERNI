# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── NestJS API ────────────────────────────────────────────────────────────────
PORT=3001
# The JWKS endpoint Nest uses to verify Supabase-issued JWTs (derived from SUPABASE_URL)
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Next.js (prefix NEXT_PUBLIC_ only for values safe to expose in browser) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# Internal server-to-server API URL (never reaches the browser)
API_INTERNAL_URL=http://localhost:3001
